rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() { return signedIn() && request.auth.token.admin == true; }

    match /users/{uid} {
      allow read, create, update: if owner(uid) || admin();
      allow delete: if admin();
      match /addresses/{addressId} { allow read, write: if owner(uid) || admin(); }
      match /wishlist/{productId} { allow read, write: if owner(uid); }
      match /notifications/{notificationId} { allow read: if owner(uid); allow write: if admin(); }
    }
    match /categories/{id} { allow read: if signedIn(); allow write: if admin(); }
    match /products/{id} { allow read: if signedIn(); allow write: if admin(); }
    match /cart/{uid} { allow read, write: if owner(uid); }
    match /orders/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || admin());
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if admin() || (signedIn() && resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentMethod']));
      allow delete: if admin();
    }
    match /coupons/{code} { allow read: if signedIn(); allow write: if admin(); }
    match /reviews/{id} { allow read: if signedIn(); allow create: if signedIn() && request.resource.data.userId == request.auth.uid; allow update, delete: if admin() || resource.data.userId == request.auth.uid; }
  }
}
